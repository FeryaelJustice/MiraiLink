<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Por defecto en toda la aplicacion se exige HTTPS seguro -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Dominio de produccion de MiraiLink -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">mirailink.xyz</domain>
        <domain includeSubdomains="true">cdn.myanimelist.net</domain>
        <domain includeSubdomains="true">media.rawg.io</domain>
        <domain includeSubdomains="true">images.igdb.com</domain>
        <domain includeSubdomains="true">images.unsplash.com</domain>
        <domain includeSubdomains="true">alphacoders.com</domain>
    </domain-config>

    <!-- Entornos locales de desarrollo y emuladores donde se permite HTTP texto claro -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="true">192.168.1.137</domain>
    </domain-config>
</network-security-config>